<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- packages.lock.json makes restores reproducible and gives Syft/Grype and
         Dependabot a dependency graph to read. Without it the SBOM job catalogs
         only GitHub Action refs and skips the vulnerability scan entirely.
         The SDK also adds implicit package references (ILLink.Tasks,
         Sdk.WebAssembly.Pack, ...) at its own bundled version, so the lockfile is
         only valid for the exact SDK in global.json. Bump both together:
         edit global.json, then restore with the force-evaluate flag and commit the
         regenerated lockfile. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.10" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyBenefitsJsonToWwwroot"
          BeforeTargets="Build">
    <MakeDir Directories="wwwroot/data" />
    <Copy SourceFiles="..\..\data\benefits.json"
          DestinationFiles="wwwroot/data/benefits.json"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CreatePagesFallback" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)wwwroot/index.html"
          DestinationFiles="$(PublishDir)wwwroot/404.html" />
  </Target>

</Project>

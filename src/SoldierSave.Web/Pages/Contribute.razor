@page "/contribute"

@inject HttpClient Http

<PageTitle>How to contribute - SoldierSave.com</PageTitle>

<h1>How to contribute</h1>
<p>
    These instructions are loaded directly from the
    <code>CONTRIBUTING.md</code> file in the SoldierSave.com GitHub repository.
    They walk through adding a new benefit and requesting a new feature.
</p>

@if (isLoading)
{
    <p>Loading contribution guide...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p>
        We could not load the contribution guide inside the app.
        You can still read it on GitHub:
        <a href="https://github.com/binbashburns/soldiersave.com/blob/main/CONTRIBUTING.md"
           target="_blank"
           rel="noopener noreferrer">
            Open CONTRIBUTING.md on GitHub
        </a>.
    </p>
    <p class="text-muted">@errorMessage</p>
}
else
{
    <pre class="contrib-markdown">@content</pre>
}

@code {
    private string? content;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // CONTRIBUTING.md is copied to wwwroot/contributing/CONTRIBUTING.md at build/publish time
            content = await Http.GetStringAsync("contributing/CONTRIBUTING.md");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}


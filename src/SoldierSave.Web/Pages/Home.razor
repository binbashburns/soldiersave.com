@page "/"

@using SoldierSave.Web.Models
@using SoldierSave.Web.Services
@inject BenefitService BenefitService

<PageTitle>SoldierSave.com</PageTitle>

<h1>SoldierSave.com</h1>
<p>Discover military benefits, discounts, and resources in one place.</p>
<p class="tagline">For warriors, by warriors.</p>

<div class="search-bar">
    <input class="search-input"
           type="search"
           aria-label="Search benefits"
           placeholder="Search benefits by name, tag, category, or description"
           @bind="SearchText"
           @bind:event="oninput" />
</div>

<div class="filter-bar">
    <strong>Filter by tag:</strong>
    @foreach (var tag in Tags)
    {
        <button class="@GetTagButtonClass(tag)"
                aria-pressed="@(string.Equals(tag, SelectedTag, StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                @onclick="@(() => SelectTag(tag))">@tag</button>
    }
</div>

@if (IsLoading)
{
    <p>Loading benefits...</p>
}
else if (LoadError is not null)
{
    <div role="alert">
        <p>@LoadError</p>
        <button class="btn btn-primary" @onclick="LoadBenefitsAsync">Try again</button>
    </div>
}
else if (FilteredBenefits.Count == 0)
{
    <p>No benefits found for the selected filter.</p>
}
else
{
    <ul class="benefit-list">
        @foreach (var benefit in FilteredBenefits)
        {
            <li class="benefit-item">
                <h2 class="h3">
                    @if (IsSafeExternalUrl(benefit.Url))
                    {
                        <a href="@benefit.Url" target="_blank" rel="noopener noreferrer">@benefit.Name</a>
                    }
                    else
                    {
                        @benefit.Name
                    }
                </h2>
                <p>@benefit.Summary</p>
                <p>
                    <small>
                        @if (benefit.Tags.Count > 0)
                        {
                            <span>Tags:</span>
                            @foreach (var tag in benefit.Tags)
                            {
                                <span class="@GetInlineTagClass(tag)">@tag</span>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(benefit.AddedBy))
                        {
                            <span>
                                · Added by:
                                @if (string.Equals(benefit.AddedBy, "@binbashburns", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="https://github.com/binbashburns"
                                       target="_blank"
                                       rel="noopener noreferrer">@benefit.AddedBy</a>
                                }
                                else
                                {
                                    @benefit.AddedBy
                                }
                            </span>
                        }
                    </small>
                </p>
            </li>
        }
    </ul>
}

@code {
    private readonly string AllTag = "All";

    private bool IsLoading { get; set; } = true;
    private string? LoadError { get; set; }
    private List<Benefit> AllBenefits { get; set; } = new();
    private List<Benefit> FilteredBenefits { get; set; } = new();
    private string SelectedTag { get; set; } = "All";
    private string SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText == value)
            {
                return;
            }

            _searchText = value;
            ApplyFilter();
        }
    }

    private string _searchText = string.Empty;

    private List<string> Tags { get; set; } = new() { "All" };

    protected override Task OnInitializedAsync() => LoadBenefitsAsync();

    private async Task LoadBenefitsAsync()
    {
        IsLoading = true;
        LoadError = null;
        try
        {
            AllBenefits = (await BenefitService.GetBenefitsAsync()).ToList();

            var allTags = AllBenefits
                .SelectMany(b => b.Tags)
                .Where(t => !string.IsNullOrWhiteSpace(t))
                .Select(t => t.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
                .ToList();

            Tags = new List<string> { AllTag };
            Tags.AddRange(allTags);

            ApplyFilter();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            LoadError = "We couldn't load the benefits. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    // Last line of defence for the href. validate_catalog.py and benefit-import.cjs
    // both reject non-HTTP(S) URLs, but they run in CI and a record edited by hand
    // and merged directly would bypass them; a javascript: URL must never become a
    // live link.
    private static bool IsSafeExternalUrl(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var parsed) &&
        (parsed.Scheme == Uri.UriSchemeHttp || parsed.Scheme == Uri.UriSchemeHttps);

    private void SelectTag(string tag)
    {
        SelectedTag = tag;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<Benefit> query = AllBenefits;

        if (SelectedTag != AllTag)
        {
            query = query.Where(b =>
                b.Tags.Any(t => string.Equals(t.Trim(), SelectedTag, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var term = SearchText.Trim();
            query = query.Where(b =>
                b.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                b.Summary.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                b.Categories.Any(c => c.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                b.Tags.Any(t => t.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        FilteredBenefits = query.ToList();
    }

    // Must match the number of .tag-color-N rules in wwwroot/css/app.css.
    private const uint TagColorCount = 8;

    private string GetTagButtonClass(string tag)
    {
        var isSelected = string.Equals(tag, SelectedTag, StringComparison.OrdinalIgnoreCase);
        return isSelected ? "tag-button selected" : $"tag-button {GetTagColorClass(tag)}";
    }

    // Color comes from a class rather than an inline style attribute: the page
    // CSP sets style-src 'self', which blocks inline styles outright.
    private static string GetTagColorClass(string tag)
    {
        // FNV-1a over the lowercased tag: unsigned and stable across processes,
        // unlike string.GetHashCode, so a tag keeps its color between reloads.
        uint hash = 2166136261;
        foreach (var character in tag.ToLowerInvariant())
        {
            hash = unchecked((hash ^ character) * 16777619);
        }

        return $"tag-color-{hash % TagColorCount}";
    }

    private string GetInlineTagClass(string tag)
    {
        var isSelected = string.Equals(tag, SelectedTag, StringComparison.OrdinalIgnoreCase);
        return isSelected ? "inline-tag selected" : "inline-tag";
    }
}
